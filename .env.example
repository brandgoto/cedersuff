# Public site URL (used by next-sitemap and metadata)
NEXT_PUBLIC_SITE_URL=https://cedersuff.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend
RESEND_FROM_EMAIL="CEDERSUFF Movers <quotes@cedersuff.com>"
# Inbox that receives quote requests
QUOTE_TO_EMAIL=
